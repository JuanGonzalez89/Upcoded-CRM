# Nunca subir .env.local al repositorio.
# Fuente de búsqueda gratuita; sin esta clave la app no simula resultados.
TAVILY_API_KEY=

# Opcional: enriquece "Analizar web" (ficha del prospecto) con el diagnóstico real de Google
# PageSpeed Insights (gratis, https://developers.google.com/speed/docs/insights/v5/get-started).
# Sin esta clave, el análisis sigue funcionando sólo con los chequeos del HTML.
GOOGLE_PAGESPEED_API_KEY=

# Autenticación y base de datos Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad para paneles antiguos: NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# El acceso lo define la tabla public.team_members (ver supabase/003_team.sql).
