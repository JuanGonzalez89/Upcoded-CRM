# Nunca subir .env.local al repositorio.
# Fuente de búsqueda gratuita; sin esta clave la app no simula resultados.
TAVILY_API_KEY=

# Autenticación y base de datos Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad para paneles antiguos: NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# El acceso lo define la tabla public.team_members (ver supabase/003_team.sql).

# Resumen diario de pendientes por email (opcional). Vercel Cron llama a /api/cron/digest
# de lunes a viernes 8:00 (ART) con Authorization: Bearer CRON_SECRET.
CRON_SECRET=
# Clave de https://resend.com y remitente de un dominio verificado, ej. "Upcoded CRM <crm@upcoded.dev>".
# Sin estas dos, el endpoint sólo devuelve la vista previa y no envía nada.
RESEND_API_KEY=
DIGEST_FROM=
